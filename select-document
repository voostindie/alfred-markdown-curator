#!/bin/zsh --no-rcs
# Lists actions for a document in the vault.
# This script requires 2 environment variables to be set: "DOCUMENT_NAME" and
# "DOCUMENT_PATH", these are exposed as variables by "list-documents".
# This script applies to all categories of documents available. The first
# couple of actions are generic; the other actions depend on the type of
# properties that accompany the document; these properties are all the front
# matter properties in the document itself. E.g. the "omnifocus" property is
# added to all project documents when OmniFocus is configured in the vault.
source ${0:a:h}/defaults
require_env DOCUMENT_NAME
require_env DOCUMENT_PATH
init_active_curator
jq -n '
{
  items: [
    {
      arg: "file://\($ENV.DOCUMENT_PATH)",
      title: "Open in default editor",
      icon: {
        type: "fileicon",
        path: $ENV.DOCUMENT_PATH
	    }
    },
    ($ENV.MARKED_APP_ENABLED | select(. == "1") | {
      arg: $ENV.DOCUMENT_PATH,
      title: "Open in Marked",
      variables: {
        APPLICATION: "Marked.app"
      },
      icon: {
        path: "/Applications/Marked.app/Contents/Resources/AppIcon.icns"
      }
    }),
    ($ENV.IA_WRITER_ENABLED | select(. == "1") | {
      arg: $ENV.DOCUMENT_PATH,
      title: "Open in iA Writer",
      variables: {
        APPLICATION: "iA Writer.app"
      },
      icon: {
        path: "/Applications/iA Writer.app/Contents/Resources/Writer.icns"
      }
    }),
    {
      arg: @uri "alfred://runtrigger/nl.ulso.curator/links/?argument=\($ENV.DOCUMENT_NAME)",
      title: "Show links",
      icon: {
        path: "/Applications/Safari.app/Contents/Resources/AppIconUpdated.icns"
      }
    },
    {
      arg: @uri "alfred://runtrigger/nl.ulso.curator/file/?argument=\($ENV.DOCUMENT_PATH)",
      title: "Show file actions",
      icon: {
        path: "/Applications/Alfred 5.app/Contents/Resources/appicon.icns"
      }
    },
    ($ENV.OMNIFOCUS_URL | select(. | length > 0) | {
      arg: .,
      title: "Open project in OmniFocus",
      icon: {
        path: "/Applications/OmniFocus.app/Contents/Resources/AppIcon.icns"
      }
    })
  ]
}
'
