#!/bin/zsh --no-rcs
source ${0:a:h}/defaults
init_active_curator
PROJECT_PATH=$(curl -s -f "$URL/curators/$CURATOR/queries/alfred" | jq -r '
.items[] | select(.name == "projects") | .value
')
curl -s -f "$URL/curators/$CURATOR/queries/ls?path=$PROJECT_PATH" | jq '
{
  items: [
    .documents[] | {
      uid: .path,
      title: .name,
      arg: .name,
      variables: ({
        document: .name,
        filepath: .path
      } + (if .properties.omnifocus then {omnifocus: .properties.omnifocus} else {} end))
    }
  ]
}
'
