#!/bin/zsh --no-rcs
source ${0:a:h}/defaults
init_active_curator
require_env category
document_path=$(curl -s -f "$URL/curators/$CURATOR/queries/alfred" | jq -r '
.items[] | select(.name == $ENV.category) | .value
')
curl -s -f -G "$URL/curators/$CURATOR/queries/ls" --data-urlencode "path=$document_path" | jq '
{
  items: [
    .documents[] | {
      uid: .path,
      title: .name,
      arg: .name,
      variables: ({
        document: .name,
        filepath: .path
      } + (if .properties.omnifocus then {omnifocus: .properties.omnifocus} else {} end))
    }
  ]
}
'
