#!/bin/zsh --no-rcs
# List all documents (and folders) in a path within the vault.
# The path to search can be provided in two ways: as a program argument, or
# as an environment variable "VAULT_PATH". The second option is used by Alfred.
source ${0:a:h}/defaults
init_active_curator
if (( # == 0 )); then
  if [[ -v VAULT_PATH ]]; then
    DOCUMENT_PATH="$VAULT_PATH"
  else
    DOCUMENT_PATH=""
  fi
else
  DOCUMENT_PATH="$1"
fi
curl -s -f -G "$URL/curators/$CURATOR/queries/ls" --data-urlencode "path=$DOCUMENT_PATH" |
jq --arg document_path "$DOCUMENT_PATH" '
{
  items: [
    (
      .documents[] | . as $document |
      (.name, .properties.aliases[]?) | {
        uid: $document.path,
        title: .,
        arg: $document.name,
        variables: (
          {
            DOCUMENT_NAME: $document.name,
            DOCUMENT_PATH: $document.path,
            DOCUMENT_SNIPPET: $document.sortable_title
          }
          + (if $document.properties.omnifocus
             then {OMNIFOCUS_URL: $document.properties.omnifocus}
             else {}
             end)
        )
      }
    ),
    (
      .folders[] | {
        uid: (if ($document_path | length) > 0 then "\($document_path)/\(.)" else . end),
        title: .,
        arg: (if ($document_path | length) > 0 then "\($document_path)/\(.)" else . end),
        icon: {
          type: "filetype",
          path: "public.folder"
        }
      }
    )
  ]
}
'
