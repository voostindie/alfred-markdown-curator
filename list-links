#!/bin/zsh --no-rcs
# Lists all links registered on a document in the vault.
# The name of the document can be provided in two ways: as a program argument, or
# as an environment variable "DOCUMENT". The second option is used by Alfred.
source ${0:a:h}/defaults
if (( # == 0 )); then
  if [[ ! -v DOCUMENT_NAME ]]; then
    print >&2 "Document name missing"
    exit 1
  fi
else
  DOCUMENT_NAME="$1"
fi
init_active_curator
curl -s -f -G "$URL/curators/$CURATOR/queries/links" --data-urlencode "document=$DOCUMENT_NAME" | jq '
{
  items: (
    if (.items | length) == 0 then
      [{ title: "No results" }]
    else
      [
        .items[] | {
          uid: .url,
          title: .name,
          arg: .url,
		  icon: {
			path: "/Applications/Safari.app/Contents/Resources/AppIconUpdated.icns"
		  }
        }
      ]
    end
  )
}'
