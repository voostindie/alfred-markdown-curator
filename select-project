#!/bin/zsh --no-rcs
source ${0:a:h}/defaults
init_active_curator
jq -n '
{
  items: [
    {
      uid: $ENV.filepath,
      arg: "file://\($ENV.filepath)",
      title: "Open \($ENV.document) in default editor",
      icon: {
        type: "fileicon",
        path: $ENV.filepath
      }
    },
    ($ENV.omnifocus | select(. != null) | {
      uid: .,
      arg: .,
      title: "Open \($ENV.document) in OmniFocus",
      icon: {
        path: "/Applications/OmniFocus.app/Contents/Resources/AppIcon.icns"
      }
    })
  ]
}
'
