if [[ ! -v URL ]]; then
	URL="http://localhost:7767"
fi
if [[ ! -v CONFIG ]]; then
	CONFIG="$HOME/.markdown-curator"
fi

init_active_curator () {
	if [[ ! -a $CONFIG ]]; then
		print >&2 "Active curator not set"
		exit 1
	fi
	CURATOR=$(cat $CONFIG)
}

require_env () {
    if [[ ! -v $1 ]]; then
        print >&2 "Required environment variable missing: $1"
        exit 1
    fi
}